# Install this file and the private key only on the recovery node.
DSP_RESTORE_ARTIFACT_DIRECTORY=/var/lib/dsp-idle-cloud/incoming
DSP_OFFSITE_BACKUP_PRIVATE_KEY=/etc/dsp-idle-cloud/backup-private.pem
DSP_RESTORE_WORK_ROOT=/var/lib/dsp-idle-cloud/restore-work
DSP_RESTORE_REPORTS=/var/lib/dsp-idle-cloud/restore-reports
DSP_RESTORE_DRILL_STATUS_FILE=/var/lib/dsp-idle-cloud/restore-drill-status.json
DSP_CLOUD_SERVER_MODULE=/opt/dsp-idle-cloud/current/index.mjs
DSP_BACKUP_NODE_ID=shanghai-recovery

