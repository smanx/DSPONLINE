# Public encryption key only. Keep the matching private key off this node.
DSP_CLOUD_DATABASE_FILE=/var/lib/dsp-idle-cloud/cloud.sqlite
DSP_OFFSITE_BACKUP_STAGING=/var/lib/dsp-idle-cloud/offsite-staging
DSP_OFFSITE_BACKUP_PUBLIC_KEY=/etc/dsp-idle-cloud/backup-public.pem
DSP_OFFSITE_BACKUP_STATUS_FILE=/var/lib/dsp-idle-cloud/offsite-backup-status.json
DSP_BACKUP_NODE_ID=hk-production
DSP_OFFSITE_BACKUP_KEEP=14

# Supported values: local, scp, rclone. "none" is for isolated tests only.
DSP_OFFSITE_BACKUP_TRANSPORT=scp
DSP_OFFSITE_BACKUP_TARGET=backup-user@backup-host:/var/lib/dsp-idle-cloud/incoming
DSP_OFFSITE_SSH_IDENTITY=/etc/dsp-idle-cloud/backup-transport-key
DSP_OFFSITE_SSH_KNOWN_HOSTS=/etc/dsp-idle-cloud/backup-known-hosts
