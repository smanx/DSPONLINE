[Unit]
Description=Verify DSP Idle cloud API liveness and write readiness through the stable proxy
After=dsp-idle-api-handoff-proxy.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/sh -c '/usr/bin/curl --fail --silent --show-error --max-time 60 http://127.0.0.1:4330/api/health >/dev/null && /usr/bin/curl --fail --silent --show-error --max-time 60 http://127.0.0.1:4330/api/ready >/dev/null'
