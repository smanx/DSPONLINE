[Unit]
Description=Verify DSP Idle cloud API health
After=dsp-idle-cloud.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/sh -c '/usr/bin/curl --fail --silent --show-error --max-time 60 http://127.0.0.1:4320/api/health >/dev/null || { /usr/bin/systemctl restart dsp-idle-cloud.service; exit 1; }'
