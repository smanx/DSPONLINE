# Generate a unique value with: openssl rand -hex 32
DSP_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Optional read-only event configuration. Keep the file outside release
# directories so a code rollback does not silently change an active timer.
DSP_ACTIVITY_CONFIG_FILE=/etc/dsp-idle-cloud/activity.json

# Tencent Cloud SES API for account verification and password reset. Use a
# dedicated CAM sub-user with only ses:SendEmail permission.
DSP_MAIL_TENCENT_SECRET_ID=
DSP_MAIL_TENCENT_SECRET_KEY=
DSP_MAIL_TENCENT_REGION=ap-hongkong
DSP_MAIL_TENCENT_FROM="DSP极简网络 <no-reply@mail.dsponline.cn>"
DSP_MAIL_TENCENT_VERIFY_TEMPLATE_ID=
DSP_MAIL_TENCENT_RESET_TEMPLATE_ID=
DSP_MAIL_REPLY_TO=

# Optional legacy account-email webhook fallback. It is used only when the
# complete Tencent SES configuration above is absent.
DSP_MAIL_WEBHOOK_URL=
DSP_MAIL_WEBHOOK_TOKEN=
