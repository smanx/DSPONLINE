# Copy the currently verified node-specific values into
# /etc/dsp-idle-cloud/runtime.env with mode 0640. Do not put secrets here.
# The release switch refuses to start the active API inside this window so a
# full automatic backup cannot compete with startup readiness.
DSP_CLOUD_BACKUP_WINDOW=03:00-04:00
DSP_ALLOWED_ORIGIN=https://node.example.invalid
# DSP_PUBLIC_BASE_URL=https://node.example.invalid
# DSP_ACTIVITY_CONFIG_FILE=/etc/dsp-idle-cloud/activity.json
