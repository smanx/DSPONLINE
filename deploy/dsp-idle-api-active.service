[Unit]
Description=DSP Idle active cloud API writer
After=network.target dsp-idle-api-handoff-proxy.service
Requires=dsp-idle-api-handoff-proxy.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=NODE_ENV=production
Environment=DSP_RELEASE_CONTROL_ROOT=/usr/local/lib/dsp-idle-release/current
Environment=DSP_RELEASE_SWITCH_STATE_FILE=/var/lib/dsp-idle-cloud/release-state/switch-state.json
Environment=DSP_RELEASE_ACTIVE_START_FILE=/var/lib/dsp-idle-cloud/release-state/pending-switch.json
Environment=DSP_API_ROOT=/opt/dsp-idle-cloud
Environment=DSP_API_WRITER_LOCK_FILE=/run/dsp-idle-cloud/writer.lock
Environment=DSP_CLOUD_DATA_FILE=/var/lib/dsp-idle-cloud/cloud.json
Environment=DSP_CLOUD_DATABASE_FILE=/var/lib/dsp-idle-cloud/cloud.sqlite
Environment=DSP_CLOUD_BACKUP_DIRECTORY=/var/lib/dsp-idle-cloud/backups
Environment=DSP_PLAYER_ONLINE_WINDOW_MS=120000
Environment=DSP_METRIC_TIME_ZONE=Asia/Shanghai
Environment=DSP_OFFSITE_BACKUP_STATUS_FILE=/var/lib/dsp-idle-cloud/offsite-backup-status.json
Environment=DSP_RESTORE_DRILL_STATUS_FILE=/var/lib/dsp-idle-cloud/restore-drill-status.json
Environment=DSP_NODE_HEALTH_STATUS_FILE=/var/lib/dsp-idle-cloud/node-health-status.json
EnvironmentFile=/etc/dsp-idle-cloud/runtime.env
EnvironmentFile=-/etc/dsp-idle-cloud/admin.env
WorkingDirectory=/opt/dsp-idle-cloud
ExecStart=/usr/local/lib/dsp-idle-release/current/api-active-entry.sh
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=75 78
TimeoutStopSec=90
RuntimeDirectory=dsp-idle-cloud
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dsp-idle-cloud /run/dsp-idle-cloud

[Install]
WantedBy=multi-user.target
