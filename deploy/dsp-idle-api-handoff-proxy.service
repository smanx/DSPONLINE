[Unit]
Description=DSP Idle API release handoff proxy
After=network.target
Before=nginx.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/usr/local/lib/dsp-idle-release/current
ExecStart=/usr/bin/node /usr/local/lib/dsp-idle-release/current/api-handoff-proxy.mjs
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=78
TimeoutStopSec=90
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4330
Environment=DSP_API_PROXY_STATE_FILE=/var/lib/dsp-idle-cloud/release-state/api-proxy.json
Environment=DSP_API_PROXY_STATUS_FILE=/run/dsp-idle-cloud/api-proxy-status.json
Environment=DSP_API_PROXY_QUEUE_LIMIT=512
Environment=DSP_API_PROXY_MAX_HOLD_MS=300000
RuntimeDirectory=dsp-idle-cloud
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dsp-idle-cloud/release-state /run/dsp-idle-cloud

[Install]
WantedBy=multi-user.target
