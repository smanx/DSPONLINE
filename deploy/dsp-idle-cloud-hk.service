[Unit]
Description=DSP Idle cloud account, save and leaderboard service
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/dsp-idle-cloud/current
ExecStart=/usr/local/lib/dsp-idle-release/current/api-writer-lock.sh /usr/bin/node /opt/dsp-idle-cloud/current/index.mjs
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=75 78
TimeoutStopSec=90
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4320
Environment=DSP_API_WRITER_LOCK_FILE=/run/dsp-idle-cloud/writer.lock
Environment=DSP_CLOUD_DATA_FILE=/var/lib/dsp-idle-cloud/cloud.json
Environment=DSP_CLOUD_DATABASE_FILE=/var/lib/dsp-idle-cloud/cloud.sqlite
Environment=DSP_CLOUD_BACKUP_DIRECTORY=/var/lib/dsp-idle-cloud/backups
Environment=DSP_CLOUD_BACKUP_INTERVAL_MS=21600000
Environment=DSP_PLAYER_ONLINE_WINDOW_MS=120000
Environment=DSP_METRIC_TIME_ZONE=Asia/Shanghai
Environment=DSP_PUBLIC_BASE_URL=https://dsponline.cn
Environment=DSP_OFFSITE_BACKUP_STATUS_FILE=/var/lib/dsp-idle-cloud/offsite-backup-status.json
Environment=DSP_RESTORE_DRILL_STATUS_FILE=/var/lib/dsp-idle-cloud/restore-drill-status.json
Environment=DSP_NODE_HEALTH_STATUS_FILE=/var/lib/dsp-idle-cloud/node-health-status.json
EnvironmentFile=/etc/dsp-idle-cloud/runtime.env
EnvironmentFile=-/etc/dsp-idle-cloud/admin.env
Environment=DSP_ALLOWED_ORIGIN=https://dsponline.cn,https://www.dsponline.cn,https://localhost,http://dsponline.cn,http://www.dsponline.cn,http://hk-origin.example.invalid,http://shanghai-ip.example.invalid,http://shanghai-node.example.invalid
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dsp-idle-cloud
RuntimeDirectory=dsp-idle-cloud
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
