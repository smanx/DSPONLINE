# Reference only. The build scripts read shell environment variables and do
# not automatically load this file.

# stable, beta, or nightly
DSP_RELEASE_CHANNEL=stable

# Community desktop builds leave these blank to disable the official cloud
# bridge and updater. Official release CI injects its own HTTPS endpoints.
DSP_DESKTOP_API_BASE_URL=
DSP_UPDATE_BASE_URL=
DSP_DESKTOP_PUBLISH_URL=

# Community Android builds leave these blank to disable cloud, account deep
# links, and in-app update checks.
DSP_ANDROID_API_BASE_URL=
DSP_ANDROID_UPDATE_BASE_URL=
DSP_ANDROID_PUBLIC_ORIGIN=

# Required only when generating a distributable native update feed.
DSP_NATIVE_UPDATE_BASE_URL=
