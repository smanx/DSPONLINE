<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Preserve player-authored IndexedDB saves, not device sessions. -->
        <include domain="root" path="app_webview/Default/IndexedDB" />
        <exclude domain="sharedpref" path="dsp_secure_session_v1.xml" />
        <exclude domain="file" path="private-exports" />
        <exclude domain="root" path="app_webview/Default/Local Storage" />
        <exclude domain="root" path="app_webview/Default/Cookies" />
        <exclude domain="root" path="app_webview/Default/Cookies-journal" />
        <exclude domain="root" path="app_webview/Default/Cache" />
        <exclude domain="root" path="app_webview/Default/Code Cache" />
        <exclude domain="root" path="app_webview/Default/GPUCache" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/IndexedDB" />
        <exclude domain="sharedpref" path="dsp_secure_session_v1.xml" />
        <exclude domain="file" path="private-exports" />
        <exclude domain="root" path="app_webview/Default/Local Storage" />
        <exclude domain="root" path="app_webview/Default/Cookies" />
        <exclude domain="root" path="app_webview/Default/Cookies-journal" />
        <exclude domain="root" path="app_webview/Default/Cache" />
        <exclude domain="root" path="app_webview/Default/Code Cache" />
        <exclude domain="root" path="app_webview/Default/GPUCache" />
    </device-transfer>
</data-extraction-rules>
